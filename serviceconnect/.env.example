# ===================== ServiceConnect — variáveis de ambiente =====================
# Copie para .env (local) ou configure no Render → Environment. NUNCA faça commit do .env.

# Token do @BotFather (obrigatório)
BOT_TOKEN=

# PostgreSQL. No Render é preenchido automaticamente a partir do banco (render.yaml).
DATABASE_URL=postgresql://postgres@localhost:5432/serviceconnect
# Esquema próprio dentro do banco (não mexe nas tabelas de outros apps)
DB_SCHEMA=serviceconnect

# URL pública. No Render não é preciso: usa RENDER_EXTERNAL_URL automaticamente.
WEBHOOK_BASE_URL=
# Segredo que o Telegram envia em cada webhook (openssl rand -hex 32)
WEBHOOK_SECRET=

# Painel administrativo (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Chave das sessões do painel (openssl rand -hex 32)
SESSION_SECRET=
# IDs do Telegram dos administradores, separados por vírgula (recebem denúncias/suporte e usam /admin e /reply)
ADMIN_TELEGRAM_IDS=

# Opcionais
COMPANY_NAME=ServiceConnect
SUPPORT_CONTACT=
RATE_LIMIT_PER_MINUTE=30
MAX_REQUESTS_PER_DAY=10
MAX_PROPOSALS_PER_DAY=40
MAX_NOTIFICATIONS_PER_REQUEST=50
