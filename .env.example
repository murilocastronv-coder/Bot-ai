# ===== Obrigatórias =====
DATABASE_URL=postgresql://postgres@localhost:5432/smartbusiness
APP_URL=http://localhost:3000
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (32 bytes; não mude depois de ter dados)
ENCRYPTION_KEY=

# ===== OpenAI (https://platform.openai.com/api-keys) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# custo por 1M tokens em USD, para o painel de custos (confira a tabela oficial)
OPENAI_COST_IN_PER_MTOK_USD=0.15
OPENAI_COST_OUT_PER_MTOK_USD=0.6

# ===== Stripe (https://dashboard.stripe.com/apikeys) =====
STRIPE_SECRET_KEY=
# Webhook endpoint: {APP_URL}/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes mensais em EUR (19,90 / 49,90 / 99,90)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# ===== WhatsApp Business Cloud API (Meta) =====
# Token de verificação que você digita no painel do app Meta (qualquer string aleatória)
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta (Configurações do app → Básico) — valida X-Hub-Signature-256
WHATSAPP_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ===== E-mail transacional (verificação e senha). Obrigatório em produção =====
# ex.: smtps://usuario:senha@smtp.seu-provedor.com:465
SMTP_URL=
MAIL_FROM="SmartBusiness AI <no-reply@seudominio.com>"

# ===== Opcionais =====
# e-mails que viram SUPERADMIN ao se cadastrar (painel /app/admin)
SUPERADMIN_EMAILS=
# e-mail exibido no botão "Contato comercial" da landing page
CONTACT_EMAIL=
# widgetKey de uma conta de demonstração (ativa o chat real na landing page)
DEMO_WIDGET_KEY=
